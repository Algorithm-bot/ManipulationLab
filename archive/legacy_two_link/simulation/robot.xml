<mujoco model="ManipulationLab Two Joint Robot">
    <compiler angle="radian" autolimits="true"/>

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <default>
        <joint damping="1.0" armature="0.01"/>
        <geom density="700" friction="0.8 0.1 0.1"/>
    </default>

    <worldbody>
        <!-- Ground -->
        <geom name="floor" type="plane"
              size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>

        <site name="target"
              pos="0.55 0.25 0.2"
              size="0.025"
              rgba="1 0 0 1"/>

        <!-- Robot base -->
        <body name="base" pos="0 0 0.1">
            <geom type="cylinder" size="0.12 0.1"
                  rgba="0.2 0.2 0.25 1"/>

            <!-- First link -->
            <body name="upper_arm" pos="0 0 0.1">
                <joint name="shoulder" type="hinge"
                       axis="0 0 1" range="-1.57 1.57"/>

                <geom name="upper_link" type="capsule"
                      fromto="0 0 0 0.5 0 0"
                      size="0.04" rgba="0.1 0.4 0.9 1"/>

                <!-- Second link -->
                <body name="forearm" pos="0.5 0 0">
                    <joint name="elbow" type="hinge"
                           axis="0 0 1" range="-2.0 2.0"/>

                    <geom name="forearm_link" type="capsule"
                          fromto="0 0 0 0.4 0 0"
                          size="0.035" rgba="0.1 0.7 0.5 1"/>

                    <!-- End effector -->
                    <site name="end_effector"
                          pos="0.4 0 0"
                          size="0.035"
                          rgba="1 0.2 0.1 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- Position actuators -->
    <actuator>
        <position name="shoulder_motor" joint="shoulder" kp="10" ctrlrange="-1.57 1.57"/>
        <position name="elbow_motor" joint="elbow" kp="10" ctrlrange="-2.0 2.0"/>
    </actuator>
    <contact>
    <exclude body1="base" body2="upper_arm"/>
</contact>
</mujoco>